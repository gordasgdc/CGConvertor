<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokeni de culoare, tema închisă (singura sursă: pensulele din Design.xaml le citesc dinamic). -->
    <Color x:Key="Tok.Bg">#14161A</Color>
    <Color x:Key="Tok.Surface">#1B1E24</Color>
    <Color x:Key="Tok.SurfaceRaised">#242932</Color>
    <Color x:Key="Tok.SurfaceHover">#2C323D</Color>
    <Color x:Key="Tok.Sunken">#0F1114</Color>
    <Color x:Key="Tok.Stroke">#2E343F</Color>
    <Color x:Key="Tok.Text">#EDEFF2</Color>
    <Color x:Key="Tok.TextSec">#B0B7C2</Color>
    <Color x:Key="Tok.TextTer">#8991A0</Color>
    <Color x:Key="Tok.Accent">#F2A04B</Color>
    <Color x:Key="Tok.AccentHover">#F7B268</Color>
    <Color x:Key="Tok.AccentText">#1B1206</Color>
    <Color x:Key="Tok.Blue">#2F8CFF</Color>
    <Color x:Key="Tok.Success">#4CD07A</Color>
    <Color x:Key="Tok.Warning">#F0B040</Color>
    <Color x:Key="Tok.Error">#F2706D</Color>
    <Color x:Key="Tok.SelectionFill">#26F2A04B</Color>
