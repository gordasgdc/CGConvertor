<UserControl x:Class="CGConvertor.Client.MetadataView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CGConvertor.Client">
    <UserControl.Resources>
        <Style x:Key="MdClipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1.5" CornerRadius="10" Padding="10,8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,14,20,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="370" MinWidth="260" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Style="{StaticResource PrimaryButton}" Click="OnAdd" Margin="0,0,6,6" Content="{Binding [md.add], Source={x:Static local:Loc.Instance}}" />
                <Button Click="OnRemove" Margin="0,0,6,6" Content="{Binding [remove], Source={x:Static local:Loc.Instance}}" />
                <Button x:Name="ScanBtn" Click="OnScan" Margin="0,0,6,6" Content="{Binding [md.scan], Source={x:Static local:Loc.Instance}}" />
            </WrapPanel>
            <ListBox x:Name="Clips" AllowDrop="True" Drop="OnDrop" SelectionChanged="OnSelect" ItemContainerStyle="{StaticResource MdClipItem}"
                     SelectionMode="Extended" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Clips">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="Search" TextChanged="OnSearch" PlaceholderText="{Binding [md.search], Source={x:Static local:Loc.Instance}}" AutomationProperties.Name="Search" />
                <Button x:Name="ExportBtn" Grid.Column="1" Margin="8,0,0,0" Click="OnExport" Content="{Binding [md.export], Source={x:Static local:Loc.Instance}}" />
            </Grid>
            <TextBlock x:Name="Msg" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Sections" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Field}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Provenance}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="{Binding [md.empty], Source={x:Static local:Loc.Instance}}" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" Width="320" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
