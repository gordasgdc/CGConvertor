<ui:FluentWindow x:Class="CGConvertor.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CGConvertor.Client"
        Title="CG Convertor" Height="780" Width="580" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Title="Settings" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,8,20,16">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="{Binding [st.theme], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnTheme" Margin="0,0,0,14" AutomationProperties.Name="Theme" />
                <TextBlock Text="{Binding [st.language], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <ComboBox x:Name="LangCombo" SelectionChanged="OnLang" Margin="0,0,0,18" AutomationProperties.Name="Language" />
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="{Binding [st.license], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock x:Name="LicState" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding [st.machineId], Source={x:Static local:Loc.Instance}}" Style="{StaticResource Caption}" />
                <DockPanel Margin="0,2,0,8">
                    <Button DockPanel.Dock="Right" Click="OnCopyId" Padding="10,4" Margin="6,0,0,0" Content="{Binding [st.copy], Source={x:Static local:Loc.Instance}}" />
                    <TextBox x:Name="MachineIdBox" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Machine ID" />
                </DockPanel>
                <TextBlock Text="{Binding [st.serial], Source={x:Static local:Loc.Instance}}" Style="{StaticResource Caption}" />
                <TextBox x:Name="SerialBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" FontFamily="Consolas" Margin="0,2,0,6" AutomationProperties.Name="Serial code" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnActivate" Content="{Binding [st.activate], Source={x:Static local:Loc.Instance}}" />
                    <TextBlock x:Name="ActMsg" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="CG Convertor" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock x:Name="VersionLine" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionLine" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Click="OnUpdate" Padding="12,5" Margin="0,0,6,6" Content="{Binding [st.update], Source={x:Static local:Loc.Instance}}" />
                    <Button Click="OnGuide" Padding="12,5" Margin="0,0,6,6" Content="{Binding [st.guide], Source={x:Static local:Loc.Instance}}" />
                    <Button Click="OnLogs" Padding="12,5" Margin="0,0,6,6" Content="{Binding [st.logs], Source={x:Static local:Loc.Instance}}" />
                    <Button Click="OnDiag" Padding="12,5" Margin="0,0,6,6" Content="{Binding [st.exportDiag], Source={x:Static local:Loc.Instance}}" />
                </WrapPanel>
                <TextBlock x:Name="UpdMsg" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button x:Name="UpdNow" Visibility="Collapsed" Click="OnUpdateNow" Padding="14,5" Margin="0,6,0,0" HorizontalAlignment="Left" Content="{Binding [st.updateNow], Source={x:Static local:Loc.Instance}}" />
                <ProgressBar x:Name="UpdBar" Visibility="Collapsed" Maximum="100" Height="6" Margin="0,6,0,0" />
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="20,0,20,16" MinWidth="96" IsCancel="True" Click="OnCloseClick" Content="{Binding [close], Source={x:Static local:Loc.Instance}}" />
    </Grid>
</ui:FluentWindow>
