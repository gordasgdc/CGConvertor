<UserControl x:Class="CGConvertor.Client.TranscodeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CGConvertor.Client">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel"><WrapPanel /></ItemsPanelTemplate>

        <!-- Rând/card selectabil: contur portocaliu la selecție (ca pe Mac), stări hover și focus clare -->
        <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1.5" CornerRadius="10" Padding="8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ListItem">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="112" Height="63" CornerRadius="6" Background="{DynamicResource SunkenBackgroundBrush}" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Visibility="{Binding Running, Converter={StaticResource B2V}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding [tc.report], Source={x:Static local:Loc.Instance}}" Click="OnShowReport" Tag="{Binding}" VerticalAlignment="Center"
                        Visibility="{Binding HasReport, Converter={StaticResource B2V}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridItem">
            <Grid Width="216" Margin="2">
                <StackPanel>
                    <Border Height="122" CornerRadius="6" Background="{DynamicResource SunkenBackgroundBrush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="2,2,2,0" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="2,6,2,0" Visibility="{Binding Running, Converter={StaticResource B2V}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>

        <!-- Zona clipurilor -->
        <DockPanel Margin="20,16,16,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Click="OnAdd" Margin="0,0,8,0" AutomationProperties.Name="Add files">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [add], Source={x:Static local:Loc.Instance}}" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Click="OnAddFolder" Margin="0,0,14,0" AutomationProperties.Name="Add folder">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [addFolder], Source={x:Static local:Loc.Instance}}" /></StackPanel>
                </Button>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="3" CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ListMode" GroupName="vm" Style="{StaticResource SegButton}" Padding="10,5" MinHeight="30" Checked="OnViewMode" IsChecked="True" AutomationProperties.Name="List" ToolTip="{Binding [view.list], Source={x:Static local:Loc.Instance}}">
                            <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" />
                        </RadioButton>
                        <RadioButton x:Name="GridMode" GroupName="vm" Style="{StaticResource SegButton}" Padding="10,5" MinHeight="30" Checked="OnViewMode" AutomationProperties.Name="Grid" ToolTip="{Binding [view.grid], Source={x:Static local:Loc.Instance}}">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="18" />
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="3" x:Name="CountText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Click="OnRemove" Margin="0,0,4,0" AutomationProperties.Name="Remove">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0" /><TextBlock Text="{Binding [remove], Source={x:Static local:Loc.Instance}}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnClear" AutomationProperties.Name="Clear" Content="{Binding [clear], Source={x:Static local:Loc.Instance}}" />
                </StackPanel>
            </Grid>
            <Grid>
                <ListBox x:Name="Clips" Background="Transparent" SelectionMode="Extended" AllowDrop="True" Drop="OnDrop" SelectionChanged="OnSelectionChanged" ItemContainerStyle="{StaticResource ClipItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         ItemTemplate="{StaticResource ListItem}" ItemsPanel="{StaticResource ListPanel}" AutomationProperties.Name="Clips" />
                <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="360">
                    <ui:SymbolIcon Symbol="VideoClip24" FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding [tc.empty], Source={x:Static local:Loc.Instance}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Inspector -->
        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,16">
                    <Border Height="190" CornerRadius="8" Background="{DynamicResource SunkenBackgroundBrush}" ClipToBounds="True" Margin="0,0,0,4">
                        <Grid>
                            <Image x:Name="PreviewImg" Stretch="Uniform" />
                            <TextBlock x:Name="NoSel" Text="{Binding [tc.noSelection], Source={x:Static local:Loc.Instance}}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
                            <Button Click="OnPreview" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" AutomationProperties.Name="Preview" Background="{DynamicResource OverlayBrush}" BorderBrush="Transparent" Foreground="White" Padding="12,5" MinHeight="30">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,6,0" /><TextBlock Text="{Binding [tc.preview], Source={x:Static local:Loc.Instance}}" Foreground="White" /></StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [tc.sectionOutput], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [tc.preset], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PresetCombo" DisplayMemberPath="Display" SelectionChanged="OnPresetChanged" AutomationProperties.Name="Preset" />
                    <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding [tc.sectionTiming], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [tc.fps], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FpsCombo" Margin="0,0,0,10" AutomationProperties.Name="Output frame rate" />
                    <TextBlock Text="{Binding [tc.color], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ColorCombo" AutomationProperties.Name="Colour space tag" />

                    <TextBlock Text="{Binding [tc.sectionInterval], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [tc.interval], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [tc.from], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="IntFrom" Grid.Column="1" LostFocus="OnIntervalChanged" AutomationProperties.Name="Interval start" />
                        <TextBlock Grid.Column="2" Text="{Binding [tc.to], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="IntTo" Grid.Column="3" LostFocus="OnIntervalChanged" AutomationProperties.Name="Interval end" />
                    </Grid>

                    <TextBlock Text="{Binding [tc.sectionDest], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [tc.output], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutBox" IsReadOnly="True" AutomationProperties.Name="Output folder" />
                        <Button Grid.Column="1" Click="OnPickOut" Margin="8,0,0,0" AutomationProperties.Name="Browse" Content="{Binding [browse], Source={x:Static local:Loc.Instance}}" />
                    </Grid>

                    <TextBlock Text="{Binding [tc.sectionOptions], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="KeepMeta" IsChecked="True" Checked="OnOpts" Unchecked="OnOpts" Content="{Binding [tc.keepMeta], Source={x:Static local:Loc.Instance}}" />
                    <CheckBox x:Name="Sidecar" IsChecked="True" Checked="OnOpts" Unchecked="OnOpts" Content="{Binding [tc.sidecar], Source={x:Static local:Loc.Instance}}" />
                    <TextBlock x:Name="HwNote" Text="{Binding [tc.hwNote], Source={x:Static local:Loc.Instance}}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bara de jos: rezumat, progres, acțiune principală -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="Summary" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Overall" Height="5" Maximum="100" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Click="OnCancel" IsEnabled="False" Margin="0,0,10,0" MinWidth="96" AutomationProperties.Name="Cancel" Content="{Binding [cancel], Source={x:Static local:Loc.Instance}}" />
                    <Button x:Name="StartBtn" Click="OnStart" Style="{StaticResource PrimaryButton}" MinWidth="170" AutomationProperties.Name="Start" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
