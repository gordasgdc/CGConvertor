<UserControl x:Class="CGConvertor.Client.OffloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CGConvertor.Client"
        xmlns:c="clr-namespace:CGConvertor.Client.Controls">
    <UserControl.Resources>
        <!-- Card de dispozitiv (sursă / copie) cu buton de scoatere lizibil -->
        <DataTemplate x:Key="EndpointCard">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <c:DeviceArtView Kind="{Binding Kind}" Width="64" Height="50" />
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Line}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" VerticalAlignment="Top" Click="OnRemoveEndpoint" Tag="{Binding}" AutomationProperties.Name="Remove" ToolTip="{Binding [remove], Source={x:Static local:Loc.Instance}}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Card de dispozitiv detectat, cu acțiuni explicite -->
        <DataTemplate x:Key="DriveCard">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="10" Width="250" MouseLeftButtonDown="OnDriveClick" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <c:DeviceArtView Kind="{Binding Kind}" Width="48" Height="38" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Line}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Click="OnDriveAsSource" Tag="{Binding}" Padding="10,3" MinHeight="26" FontSize="12" Margin="0,0,6,0" AutomationProperties.Name="Use as source" Content="{Binding [of.asSource], Source={x:Static local:Loc.Instance}}" />
                            <Button Click="OnDriveAsDest" Tag="{Binding}" Padding="10,3" MinHeight="26" FontSize="12" AutomationProperties.Name="Use as destination" Content="{Binding [of.asDest], Source={x:Static local:Loc.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>

        <!-- Bara de sus: identificarea transferului și acțiunile -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ProjectBox" Width="190" LostFocus="OnOpt" TextChanged="OnFolderName" AutomationProperties.Name="Project" PlaceholderText="{Binding [of.project], Source={x:Static local:Loc.Instance}}" />
                <ui:TextBox x:Name="CardBox" Grid.Column="1" Width="130" Margin="8,0,0,0" LostFocus="OnOpt" TextChanged="OnFolderName" AutomationProperties.Name="Card" PlaceholderText="{Binding [of.card], Source={x:Static local:Loc.Instance}}" />
                <TextBlock x:Name="FolderPreview" Grid.Column="2" Margin="14,0,10,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="SendBtn" ToolTip="{Binding [of.send], Source={x:Static local:Loc.Instance}}" IsEnabled="False" Click="OnSend" Margin="0,0,8,0" AutomationProperties.Name="Send verified files to Transcode">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="16" Margin="0,0,8,0" /><TextBlock x:Name="SendLbl" Text="{Binding [of.send], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                    </Button>
                    <Button x:Name="PdfBtn" ToolTip="{Binding [of.pdf], Source={x:Static local:Loc.Instance}}" IsEnabled="False" Click="OnPdf" Margin="0,0,8,0" AutomationProperties.Name="Open PDF report">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Margin="0,0,8,0" /><TextBlock x:Name="PdfLbl" Text="{Binding [of.pdf], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                    </Button>
                    <Button x:Name="OpenBtn" ToolTip="{Binding [of.openDest], Source={x:Static local:Loc.Instance}}" IsEnabled="False" Click="OnOpenDest" Margin="0,0,8,0" AutomationProperties.Name="Open destination">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0" /><TextBlock x:Name="OpenLbl" Text="{Binding [of.openDest], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="4" x:Name="StartBtn" Margin="0" Click="OnStart" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Start">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [of.startTransfer], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                    </Button>
            </Grid>
        </Border>

        <!-- Ruta: sursă → verificare → copii -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="20,16,14,10">
                <Grid MinHeight="250">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="230" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" MinWidth="230" /></Grid.ColumnDefinitions>
                    <Border Background="Transparent" AllowDrop="True" Drop="OnDropSource">
                    <StackPanel VerticalAlignment="Center">
                        <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource EndpointCard}" AutomationProperties.Name="Sources" />
                        <Button Click="OnAddSource" HorizontalAlignment="Left" AutomationProperties.Name="Add source">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [of.addSource], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    </Border>
                    <!-- Nodul central: starea verificării -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="104" Height="104" CornerRadius="26" BorderThickness="2.5" x:Name="HubRing" BorderBrush="{DynamicResource CardStrokeBrush}" Background="{DynamicResource CardBackgroundBrush}">
                            <ui:SymbolIcon x:Name="HubIcon" Symbol="ArrowRight24" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock x:Name="HubTitle" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="HubSub" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="Transparent" AllowDrop="True" Drop="OnDropDest">
                    <StackPanel VerticalAlignment="Center">
                        <ItemsControl x:Name="DestList" ItemTemplate="{StaticResource EndpointCard}" AutomationProperties.Name="Destinations" />
                        <Button Click="OnAddDest" HorizontalAlignment="Left" AutomationProperties.Name="Add destination">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [of.addDest], Source={x:Static local:Loc.Instance}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                        </Button>
                    </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding [of.drives], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,22,0,8" />
                <ItemsControl x:Name="DriveList" ItemTemplate="{StaticResource DriveCard}" AutomationProperties.Name="Drives">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Panou dreapta: rezultat și opțiuni -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,16">
                    <TextBlock x:Name="ResultTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" />

                    <TextBlock Text="{Binding [of.activity], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="ActivityBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="64" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log" />

                    <TextBlock Text="{Binding [of.sectionVerify], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [of.verify], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="VerifyCombo" SelectionChanged="OnOpt" AutomationProperties.Name="Verification" />
                    <CheckBox x:Name="MhlCheck" Checked="OnOpt" Unchecked="OnOpt" Margin="0,10,0,0" Content="{Binding [of.mhl], Source={x:Static local:Loc.Instance}}" />
                    <CheckBox x:Name="MetaCheck" Checked="OnOpt" Unchecked="OnOpt" Content="{Binding [of.extract], Source={x:Static local:Loc.Instance}}" />

                    <TextBlock Text="{Binding [of.sectionProduction], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding [of.camera], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CameraBox" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [of.operator], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OperatorBox" LostFocus="OnOpt" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [of.client], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ClientBox" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [of.notes], Source={x:Static local:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bara de jos: progres și control -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="Status" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Bar" Maximum="100" Height="5" Margin="0,6,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="Detail" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseBtn" IsEnabled="False" Click="OnPause" Margin="0,0,8,0" MinWidth="96" AutomationProperties.Name="Pause" Content="{Binding [pause], Source={x:Static local:Loc.Instance}}" />
                    <Button x:Name="CancelBtn" IsEnabled="False" Click="OnCancel" MinWidth="96" AutomationProperties.Name="Cancel" Content="{Binding [cancel], Source={x:Static local:Loc.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
