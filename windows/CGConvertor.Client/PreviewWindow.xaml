<ui:FluentWindow x:Class="CGConvertor.Client.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CG Convertor" Height="620" Width="900" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Title="Preview" />
        <Border Grid.Row="1" Margin="16,8" CornerRadius="6" Background="{DynamicResource SunkenBackgroundBrush}">
            <Image x:Name="Frame" Stretch="Uniform" AutomationProperties.Name="Frame preview" />
        </Border>
        <StackPanel Grid.Row="2" Margin="16,0,16,14">
            <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="OnSeek" AutomationProperties.Name="Seek" />
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Click="OnSetStart" Padding="12,5" Margin="0,0,6,0" />
                    <Button x:Name="BtnEnd" Click="OnSetEnd" Padding="12,5" Margin="0,0,6,0" />
                    <Button x:Name="BtnClose" Click="OnClose" Padding="12,5" />
                </StackPanel>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" FontFamily="Consolas" />
            </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
