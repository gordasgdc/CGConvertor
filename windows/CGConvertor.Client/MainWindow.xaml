<ui:FluentWindow x:Class="CGConvertor.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CGConvertor.Client"
        Title="CG Convertor" Height="820" Width="1320" MinWidth="880" MinHeight="520" SizeChanged="OnWinSize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="MainTitleBar" Title="CG Convertor" Icon="pack://application:,,,/app.ico" />

        <!-- Antet: identitate, file, stare și acțiuni rapide -->
        <Grid Grid.Row="1" Margin="20,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                <Image Source="pack://application:,,,/app.ico" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CG Convertor" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4" CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" x:Name="TabBar">
                    <RadioButton x:Name="TabTranscode" GroupName="tabs" IsChecked="True" Style="{StaticResource SegButton}" Margin="0,0,2,0"
                                 Checked="OnTab" Tag="0" Content="{Binding [tab.transcode], Source={x:Static local:Loc.Instance}}" AutomationProperties.Name="Transcode" />
                    <RadioButton x:Name="TabOffload" GroupName="tabs" Style="{StaticResource SegButton}" Margin="0,0,2,0"
                                 Checked="OnTab" Tag="1" Content="{Binding [tab.offload], Source={x:Static local:Loc.Instance}}" AutomationProperties.Name="Offload" />
                    <RadioButton x:Name="TabMetadata" GroupName="tabs" Style="{StaticResource SegButton}"
                                 Checked="OnTab" Tag="2" Content="{Binding [tab.metadata], Source={x:Static local:Loc.Instance}}" AutomationProperties.Name="Metadata" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ReadyPill" Style="{StaticResource Card}" Padding="12,6" CornerRadius="16" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ReadyDot" Width="8" Height="8" Fill="{DynamicResource StatusSuccessBrush}" Margin="0,1,8,0" />
                        <TextBlock x:Name="ReadyText" FontSize="13" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Click="OnThemeToggle" x:Name="ThemeBtn" AutomationProperties.Name="Theme" ToolTip="{Binding [st.theme], Source={x:Static local:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="DarkTheme24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OnLangToggle" x:Name="LangBtn" Width="44" Padding="0" AutomationProperties.Name="Language" FontWeight="SemiBold" ToolTip="{Binding [st.language], Source={x:Static local:Loc.Instance}}" />
                <Button Style="{StaticResource IconButton}" Click="OnUpdateClick" AutomationProperties.Name="Check for updates" ToolTip="{Binding [st.update], Source={x:Static local:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnHelp" AutomationProperties.Name="Help" ToolTip="{Binding [st.guide], Source={x:Static local:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnSettings" x:Name="SettingsButton" AutomationProperties.Name="Settings" ToolTip="{Binding [settings], Source={x:Static local:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Banda de licență -->
        <Border Grid.Row="2" x:Name="LicenseStrip" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,1" Padding="24,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnSettings" x:Name="ActivateBtn" Padding="10,2" MinHeight="26"
                        Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Content="{Binding [lic.activate], Source={x:Static local:Loc.Instance}}" />
                <TextBlock x:Name="LicenseStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" x:Name="Pages">
            <local:TranscodeView x:Name="TranscodePage" />
            <local:OffloadView x:Name="OffloadPage" Visibility="Collapsed" />
            <local:MetadataView x:Name="MetadataPage" Visibility="Collapsed" />
        </Grid>
        <Border Grid.Row="3" x:Name="LockBar" Visibility="Collapsed" Margin="16,8,16,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1" VerticalAlignment="Top">
            <TextBlock x:Name="LockText" TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>
